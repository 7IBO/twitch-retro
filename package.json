{
  "name": "twitch-retro",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "check:dashes": "bun scripts/check-dashes.ts",
    "check:copy": "bun scripts/check-copy.ts",
    "check:ids": "bun scripts/check-ids.ts",
    "test": "bun test",
    "check:all": "bun scripts/check-dashes.ts && bun scripts/check-copy.ts && bun scripts/check-ids.ts && bun test",
    "prepare": "node scripts/install-hooks.ts || exit 0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.81.0",
    "fflate": "^0.8.3",
    "svelte": "^5.59.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/node": "^26.6.11",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.4.0"
  }
}
